<!DOCTYPE html>
<html>

<head>
    <title>To-Do List</title>
</head>

<body>
    <h1>To-Do List</h1>
    <ul>
        <% todos.forEach((todo)=> { %>
            <li>
                <div>ID: <%= todo.id %> -
                        <%= todo.title %>
                            <% if (todo.done) { %>
                                (Done)
                                <% } %>
                                    <form action="/edit/<%= todo.id %>" method="GET" style="display:inline;">
                                        <button type="submit">Edit</button>
                                    </form>
                                    <form action="/<%= todo.id %>" method="POST" style="display:inline;">
                                        <button type="submit">Delete</button>
                                    </form>
                </div>
            </li>
            <% }); %>
    </ul>
    <form action="/" method="POST">
        <input type="text" name="title" placeholder="Title" required>
        <input type="text" name="description" placeholder="Description">
        <button type="submit">Add</button>
    </form>


    <h1>Search by ID</h1>
    <form action="/" method="GET">
        <input type="text" name="id" placeholder="ID" required>
        <button type="submit">Search</button>
    </form>

    <% if (notFound) { %>
        <p>Invalid ID</p>
        <% } else if (searchResult) { %>
            <p>Title: <%= searchResult.title %>
            </p>
            <p>Description: <%= searchResult.description %>
            </p>
            <p>Completed: <%= searchResult.done==="on" ? "Yes" : "No" %>
            </p>
            <% } %>

    <h1>Add new to-do</h1>
    <form action="/add" method="GET">
        <button type="submit">Add new to-do</button>
    </form>
</body>


</html>