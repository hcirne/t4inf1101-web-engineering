<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit To-Do</title>
</head>
<body>
    <form action="/edit/<%= todo.id %>" method="POST">
        <h2>ID: <%= todo.id %></h2>
        <label for="title">Title</label>
        <br>
        <input type ="text" id="title" name="title" value="<%= todo.title %>" required>
        <br>
        <label for="description">Description</label>
        <br>
        <textarea id="description" name="description"><%= todo.description %></textarea>
        <br>
        <label for="done">Completed?</label>
        <input type="checkbox" id="done" name="done" <% if (todo.done) { %>checked<% } %>> 
        <br>
        <button type="submit">Edit</button>
    </form>
</body>
</html>